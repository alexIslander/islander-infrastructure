# OCI Authentication (for local development)
tenancy_ocid     = "ocid1.tenancy.oc1..<REPLACE_ME>"
user_ocid        = "ocid1.user.oc1..<REPLACE_ME>"
fingerprint      = "<REPLACE_ME>"
private_key_path = "~/.oci/oci_api_key.pem"
region           = "us-ashburn-1"

# Compute Configuration
compartment_id   = "ocid1.compartment.oc1..<REPLACE_ME>"

# Provide the SSH public key CONTENT, not a path.
# Example: ssh_public_key = file("~/.ssh/oci_arm_key.pub") for local-only usage
# For Terraform Cloud, paste the key content directly here or set as a variable there.
ssh_public_key   = "<PASTE_YOUR_PUBLIC_KEY_CONTENT>"

# Optional tuning
instance_ocpus     = 2
instance_memory_gb = 12
volume_size_gbs    = 100

